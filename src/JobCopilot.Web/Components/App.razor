<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["JobCopilot.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />

    @* Lives outside the interactive tree so it can be shown even when the first render fails. *@
    <div id="blazor-error-ui" data-nosnippet>
        Ett oväntat fel inträffade.
        <a href="." class="reload">Ladda om</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Prerendering is off: every page needs a login anyway, and it would load each page's data twice.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Pages that must run as a plain HTTP request (login, error) opt out with [ExcludeFromInteractiveRouting].
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
