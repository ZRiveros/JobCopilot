# Copy to .env and change the values. .env is git-ignored – never commit it.

# The password you log in to JobCopilot with (at least 8 characters).
JOBCOPILOT_PASSWORD=change-me-to-a-long-passphrase

# ---- Database: choose ONE of the two options ----

# Option 1 (default): run PostgreSQL in a container next to the app.
# Use letters and digits in the password; ';' and quotes would need escaping in the connection string.
COMPOSE_PROFILES=bundled-db
POSTGRES_PASSWORD=change-me-as-well

# Option 2: use a PostgreSQL server you already run. Set COMPOSE_PROFILES to empty above and
# give the full connection string here. The database must exist; tables are created on start.
# "host.docker.internal" reaches a server on the Docker host itself.
# JOBCOPILOT_DB_CONNECTION=Host=host.docker.internal;Port=5432;Database=jobcopilot;Username=jobcopilot;Password=secret;Maximum Pool Size=10

# ---- Optional ----

# Port on the host.
JOBCOPILOT_PORT=8080

# Minutes between fetches from JobTech (5–1440).
FETCH_INTERVAL_MINUTES=60

# true when a reverse proxy (Caddy, nginx, Traefik) terminates HTTPS in front of the app.
BEHIND_PROXY=false
